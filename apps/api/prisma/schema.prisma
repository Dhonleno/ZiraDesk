generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Schema PUBLIC — dados globais do SaaS
// Dados de cada tenant vivem em schemas isolados
// ─────────────────────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  priceMonth  Decimal  @map("price_month") @db.Decimal(10, 2)
  priceYear   Decimal  @map("price_year") @db.Decimal(10, 2)
  maxUsers    Int      @map("max_users")
  maxContacts Int      @map("max_contacts")
  maxMessages Int      @default(-1) @map("max_messages")
  /// JSON com flags de features habilitadas no plano
  features    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  /// Nome do schema PostgreSQL isolado deste tenant (ex: tenant_acme)
  schemaName  String       @unique @map("schema_name")
  planId      String       @map("plan_id")
  status      TenantStatus @default(trial)
  trialEndsAt DateTime?    @map("trial_ends_at")
  /// Configurações do tenant (timezone, logo_url, etc.)
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")

  plan           Plan               @relation(fields: [planId], references: [id])
  subscriptions  Subscription[]
  usageSnapshots UsageSnapshot[]
  voiceConfig    TenantVoiceConfig?

  @@map("tenants")
}

/// Espelha a tabela criada pela migration 20260613120000_add_tenant_voice_config,
/// que existia sem model correspondente (drift registrado no §16). O model é
/// sincronização de schema, não mudança de banco: escrito a partir da
/// introspecção, para que `migrate diff` volte vazio nesta tabela.
model TenantVoiceConfig {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @unique @map("tenant_id")
  twilioPhoneNumber  String   @unique @map("twilio_phone_number") @db.VarChar(20)
  defaultBotMenuId   String?  @map("default_bot_menu_id") @db.Uuid
  ivrEnabled         Boolean  @default(true) @map("ivr_enabled")
  ringTimeoutSeconds Int      @default(20) @map("ring_timeout_seconds")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([twilioPhoneNumber], map: "idx_tenant_voice_config_phone")
  @@map("tenant_voice_config")
}

model UsageSnapshot {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  metric    String
  period    String
  value     BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, period])
  @@map("usage_snapshots")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Gateway usado: stripe | pagarme | manual
  paymentGateway     String?            @map("payment_gateway")
  /// ID da subscription no gateway externo
  gatewaySubId       String?            @map("gateway_sub_id")
  createdAt          DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model SuperAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("super_admins")
}

/// Leads do formulário público da landing page (ziradesk.com).
/// Vive em public: não pertence a nenhum tenant — é anterior ao cadastro.
model Lead {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model ConversationCloseType {
  id            String         @id @default(cuid())
  label         String         @unique
  isDefault     Boolean        @default(false) @map("is_default")
  isActive      Boolean        @default(true) @map("is_active")
  order         Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations Conversation[] @relation("ConversationCloseTypeToConversation")

  @@map("conversation_close_types")
}

model ConversationCloseOutcome {
  id            String         @id @default(cuid())
  label         String         @unique
  isDefault     Boolean        @default(false) @map("is_default")
  isActive      Boolean        @default(true) @map("is_active")
  order         Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations Conversation[] @relation("ConversationCloseOutcomeToConversation")

  @@map("conversation_close_outcomes")
}

model Conversation {
  id               String                    @id @db.Uuid
  status           ConversationStatus        @default(open)
  closeTypeId      String?                   @map("close_type_id")
  closeOutcomeId   String?                   @map("close_outcome_id")
  closedAt         DateTime?                 @map("closed_at")
  csatExpiresAt    DateTime?                 @map("csat_expires_at")
  closureReason    Json?                     @map("closure_reason")
  /// TIMESTAMPTZ no banco desde 20260523120000_restructure_conversation_status.
  /// Sem @db.Timestamptz o Prisma assume timestamp(3) sem timezone e o diff
  /// pede uma conversão que rotacionaria os valores para o TZ da sessão.
  /// As irmãs closed_at/csat_expires_at são timestamp(3) de fato — não marcar.
  waitingExpiresAt DateTime?                 @map("waiting_expires_at") @db.Timestamptz(6)
  queueEnteredAt   DateTime?                 @map("queue_entered_at") @db.Timestamptz(6)
  closeType        ConversationCloseType?    @relation("ConversationCloseTypeToConversation", fields: [closeTypeId], references: [id], onDelete: SetNull)
  closeOutcome     ConversationCloseOutcome? @relation("ConversationCloseOutcomeToConversation", fields: [closeOutcomeId], references: [id], onDelete: SetNull)

  @@map("conversations")
}

enum ConversationStatus {
  open
  waiting
  closed

  @@map("conversation_status")
}

enum TenantStatus {
  active
  suspended
  trial
  cancelled
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  trialing
}
